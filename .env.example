# Copy this file to .env — no API keys needed, everything runs locally.
# Never commit .env to git.

# Vector DB (change to http://qdrant:6333 when running inside Docker Compose)
QDRANT_URL=http://localhost:6333

# Local LLM via Ollama (change to http://host.docker.internal:11434 inside Docker)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=phi3:latest

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
